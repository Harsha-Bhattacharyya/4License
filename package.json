{
  "name": "hopl-website",
  "version": "1.0.0",
  "private": true,
  "description": "HOPL License static website built with Jekyll, Tailwind CSS, Alpine.js, and Webpack",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "webpack:dev": "webpack --mode development",
    "webpack:prod": "webpack --mode production",
    "jekyll:build": "jekyll build",
    "jekyll:serve": "jekyll serve --livereload",
    "prebuild": "node scripts/build-license-page.js",
    "build": "npm run webpack:prod && npm run jekyll:build",
    "serve": "npm run webpack:dev && jekyll serve --livereload",
    "license:build": "node scripts/license-convert.js",
    "license:check": "node scripts/license-check.js",
    "lint:js": "eslint 'src/**/*.js' 'scripts/**/*.js' webpack.config.js",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "eslint --fix 'src/**/*.js' 'scripts/**/*.js' webpack.config.js && stylelint --fix 'src/**/*.css'",
    "format": "prettier --write '**/*.{json,yml,yaml,md,css}' --ignore-path .gitignore",
    "format:check": "prettier --check '**/*.{json,yml,yaml,md,css}' --ignore-path .gitignore",
    "analyze": "webpack --mode production --env analyze"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "alpinejs": "^3.14.9",
    "autoprefixer": "^10.4.21",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^8.57.1",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.5.3",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^37.0.0",
    "tailwindcss": "^3.4.17",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  }
}
